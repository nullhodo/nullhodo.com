---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <title>nullhodo</title>
        <meta name="description" content="nullhodo's personal portfolio website." />
        <meta property="og:url" content="https://nullhodo.com/" />
        <meta property="og:type" content="website" />
        <meta property="og:title" content="nullhodo" />
        <meta
            property="og:image"
            content="https://nullhodo.com/assets/ogp.png"
        />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:site" content="@nullhodo" />
        <meta name="twitter:creator" content="@nullhodo" />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@300;400;500;700;900&display=swap"
            rel="stylesheet"
        />

        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <link rel="canonical" href="https://nullhodo.com/" />

        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "Person",
                "name": "nullhodo",
                "url": "https://nullhodo.com/",
                "sameAs": [
                    "https://x.com/nullhodo",
                    "https://bsky.app/profile/nullhodo.bsky.social",
                    "https://fedibird.com/@nullhodo",
                    "https://github.com/nullhodo"
                ],
                "jobTitle": "Developer / Creator",
                "knowsAbout": [
                    "Generative Art",
                    "Creative Coding",
                    "p5.js",
                    "Three.js",
                    "Web Development"
                ]
            }
        </script>

        <style>
            .social-links {
                list-style: none;
                padding: 0;
                margin: 0;
            }

            .social-links a {
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                color: var(--link-color);
                text-decoration: none;
                transition: color 0.2s;
            }

            .social-links a:hover {
                color: var(--link-hover-color);
            }

            .social-links a:hover span {
                text-decoration: underline;
            }

            .social-icon {
                width: 1.15em;
                height: 1.15em;
                color: var(--text-color);
                fill: currentColor;
                flex-shrink: 0;
                transition: color 0.2s;
            }

            .social-links a:hover .social-icon {
                color: var(--link-hover-color);
            }
        </style>
    </head>
    <body>
        <header>
            <h1>nullhodo</h1>
        </header>
        <main>
            <h2>About me</h2>
            <p>
                <span class="text-block">Developer / Creator.</span>{' '}
                <span class="text-block">I make generative art, interactive web applications,</span>{' '}
                <span class="text-block">and various other things.</span>
            </p>
            <h2>Artworks</h2>
            <p>
                <a href="/artworks/">View Gallery</a>
            </p>
            <h2>Socials</h2>
            <ul class="social-links">
                <li>
                    <a
                        href="https://x.com/nullhodo"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                        </svg>
                        <span>X</span>
                    </a>
                </li>
                <li>
                    <a
                        href="https://bsky.app/profile/nullhodo.bsky.social"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.298-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8z" />
                        </svg>
                        <span>Bluesky</span>
                    </a>
                </li>
                <li>
                    <a
                        href="https://fedibird.com/@nullhodo"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M23.268 5.313c-.35-2.578-2.617-4.61-5.304-5.004C17.51.242 15.792 0 11.813 0h-.03c-3.98 0-4.835.242-5.288.309C3.882.692 1.496 2.518.917 5.127.64 6.412.61 7.837.661 9.143c.074 1.874.088 3.745.26 5.611.118 1.24.325 2.47.62 3.68.55 2.237 2.777 4.098 4.96 4.857 2.336.792 4.849.923 7.256.38.265-.061.527-.132.786-.213.585-.184 1.27-.39 1.774-.753a.057.057 0 0 0 .023-.043v-1.809a.052.052 0 0 0-.02-.041.053.053 0 0 0-.046-.01 20.282 20.282 0 0 1-4.709.545c-2.73 0-3.463-1.284-3.674-1.818a5.593 5.593 0 0 1-.319-1.433.053.053 0 0 1 .066-.054c1.517.363 3.072.546 4.632.546.376 0 .75 0 1.125-.01 1.57-.044 3.224-.124 4.768-.422.038-.008.077-.015.11-.024 2.435-.464 4.753-1.92 4.989-5.604.008-.145.03-1.52.03-1.67.002-.512.167-3.63-.024-5.545zm-3.748 9.195h-2.561V8.29c0-1.309-.55-1.976-1.67-1.976-1.23 0-1.846.79-1.846 2.35v3.403h-2.546V8.663c0-1.56-.617-2.35-1.848-2.35-1.112 0-1.668.668-1.67 1.977v6.218H4.822V8.102c0-1.31.337-2.35 1.011-3.12.696-.77 1.608-1.164 2.74-1.164 1.311 0 2.302.5 2.962 1.498l.638 1.06.638-1.06c.66-.999 1.65-1.498 2.96-1.498 1.13 0 2.043.395 2.74 1.164.675.77 1.012 1.81 1.012 3.12z" />
                        </svg>
                        <span>Fedibird</span>
                    </a>
                </li>
                <li>
                    <a
                        href="https://github.com/nullhodo"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
                        </svg>
                        <span>GitHub</span>
                    </a>
                </li>
            </ul>
        </main>
    </body>
</html>
